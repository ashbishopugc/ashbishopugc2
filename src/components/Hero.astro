---
import Pixel from './Pixel.astro';
import Icon from './Icon.astro';
import { site } from '../lib/data';
import { palm, hills, house, cloud, twinkle, icons } from '../lib/sprites';

const { hero } = site;
const stars = [
  { x: 12, y: 14, d: 0 }, { x: 28, y: 8, d: 1.2 }, { x: 47, y: 18, d: 0.6 },
  { x: 63, y: 6, d: 2 }, { x: 81, y: 15, d: 1.6 }, { x: 92, y: 30, d: 0.3 },
];
---
<section id="home" class="hero" aria-labelledby="hero-name">
  <div class="scene" aria-hidden="true">
    {stars.map((s) => (
      <Pixel sprite={twinkle} class="star" style={`left:${s.x}%;top:${s.y}%;animation-delay:${s.d}s`} />
    ))}
    <Pixel sprite={cloud} class="cloud c1" />
    <Pixel sprite={cloud} class="cloud c2" />
    <Pixel sprite={cloud} class="cloud c3" />
    <Pixel sprite={palm} class="palm p1" />
    <Pixel sprite={palm} class="palm p2" />
    <Pixel sprite={hills} class="hills h1" />
    <Pixel sprite={hills} class="hills h2" />
    <Pixel sprite={house} class="house" />
    <div class="ground"></div>
  </div>

  <div class="wrap hero-grid">
    <div class="copy">
      <p class="eyebrow">— Player one —</p>
      <h1 id="hero-name" class="name">{site.name}</h1>
      <div class="tri name-stripe" aria-hidden="true"></div>
      <p class="niche">{site.niche}</p>
      <p class="caps where">{site.location}</p>
      <p class="hand tagline">{hero.tagline}</p>
      <div class="ctas">
        <a class="btn btn-primary" href="#work"><Pixel sprite={icons.play} />{hero.primaryButton}</a>
        <a class="btn btn-ghost" href="#contact">{hero.secondaryButton}</a>
      </div>
    </div>

    <div class="reel-wrap">
      <div class="phone frame">
        {hero.reel ? (
          <video
            class="reel"
            autoplay
            muted
            loop
            playsinline
            preload="auto"
            poster={hero.reelPoster || undefined}
            aria-label={`Highlight reel of ${site.name}'s UGC videos`}
            data-hero-reel
          >
            {hero.reelWebm && <source src={hero.reelWebm} type="video/webm" />}
            <source src={hero.reel} type="video/mp4" />
            {hero.reelCaptions && <track kind="captions" src={hero.reelCaptions} srclang="en" label="English" default />}
          </video>
        ) : (
          <div class="reel reel-demo" role="img" aria-label="Placeholder for Ash's highlight reel">
            <span class="eyebrow">Now playing</span>
            <span class="demo-lines" aria-hidden="true">
              <span>Hook</span><span>Demo</span><span>Payoff</span>
            </span>
            <span class="eyebrow small">Reel coming soon</span>
          </div>
        )}
        {hero.reel && (
          <button class="mute" type="button" data-mute aria-pressed="true" aria-label="Unmute reel">
            <Icon name="mute" size={18} class="i-muted" /><Icon name="sound" size={18} class="i-sound" />
          </button>
        )}
      </div>
    </div>
  </div>

  <a class="scroll-cue" href="#about" aria-label="Scroll to About">
    <span>Scroll</span>
    <Pixel sprite={icons.arrowDown} />
  </a>

  <div class="rewind-fx" aria-hidden="true" data-rewind>
    <span class="rw-label">◀◀ Rewind</span>
  </div>
</section>

<style>
  .hero {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: calc(100svh - var(--track-h)); display: flex; flex-direction: column; justify-content: center;
    padding: calc(var(--header-h) + 8px) 0 72px;
    background: linear-gradient(180deg, #E6D9F4 0%, #EFE5F3 45%, var(--bg) 100%);
  }
  :global([data-theme='dark']) .hero { background: linear-gradient(180deg, #2B1B47 0%, #1E1533 55%, var(--bg) 100%); }

  /* Scene */
  .scene { position: absolute; inset: 0; z-index: -1; pointer-events: none; color: #B99AE6; }
  .scene :global(.star) { position: absolute; width: 9px; color: var(--gold); animation: twinkle 2.6s steps(2) infinite; }
  .scene :global(.cloud) { position: absolute; color: #fff; opacity: 0.75; animation: drift 48s linear infinite; }
  :global([data-theme='dark']) .scene :global(.cloud) { color: #5A4580; opacity: 0.6; }
  .scene :global(.c1) { width: 84px; top: 12%; left: -10%; }
  .scene :global(.c2) { width: 60px; top: 24%; left: 30%; animation-duration: 64s; animation-delay: -20s; }
  .scene :global(.c3) { width: 72px; top: 6%; left: 70%; animation-duration: 56s; animation-delay: -36s; }
  .scene :global(.palm) { position: absolute; bottom: 30px; }
  .scene :global(.p1) { left: 2%; width: 72px; }
  .scene :global(.p2) { left: 12%; width: 48px; bottom: 32px; opacity: 0.8; }
  .scene :global(.hills) { position: absolute; bottom: 28px; }
  .scene :global(.h1) { right: -2%; width: 240px; color: #B99AE6; opacity: 0.55; }
  .scene :global(.h2) { right: 14%; width: 160px; color: #9C7BD0; opacity: 0.45; }
  .scene :global(.house) { position: absolute; right: 8%; bottom: 33px; width: 44px; color: #6B3FA0; opacity: 0.7; }
  :global([data-theme='dark']) .scene :global(.house) { color: #B99AE6; }
  .ground {
    position: absolute; inset: auto 0 0; height: 30px;
    background:
      linear-gradient(var(--teal) 0 3px, var(--red) 3px 6px, var(--orange) 6px 9px, transparent 9px),
      repeating-linear-gradient(90deg, color-mix(in srgb, var(--reign) 14%, transparent) 0 6px, transparent 6px 12px);
    opacity: 0.55;
  }
  @keyframes twinkle { 50% { opacity: 0.15; } }
  @keyframes drift { to { transform: translateX(130vw); } }

  @media (max-width: 719px) {
    .scene :global(.p2), .scene :global(.h2) { display: none; }
    .scene :global(.p1) { width: 52px; }
    .scene :global(.h1) { width: 150px; }
    .scene :global(.house) { width: 32px; right: 6%; }
  }

  /* Layout */
  .hero-grid { display: grid; gap: 24px; justify-items: center; text-align: center; }
  .copy { display: flex; flex-direction: column; align-items: center; }
  .name { font-size: clamp(2.6rem, 12vw, 5.5rem); font-weight: 800; letter-spacing: -0.02em; }
  .name-stripe { width: min(260px, 70%); height: 12px; margin: 14px 0 16px; transform-origin: left; animation: stripe-in 700ms 300ms var(--ease) backwards; }
  @keyframes stripe-in { from { transform: scaleX(0); } }
  .niche { font-weight: 600; font-size: clamp(1.05rem, 3.6vw, 1.35rem); }
  .where { color: var(--muted); margin-top: 6px; font-size: 0.75rem; }
  .tagline { font-size: clamp(1.6rem, 6vw, 2.1rem); margin-top: 10px; transform: rotate(-2deg); }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 18px; }

  .reel-wrap { width: min(60vw, calc((100svh - 520px) * 9 / 16), 300px); min-width: 150px; }
  .phone { --tilt: 2deg; position: relative; padding: 7px; border-radius: 22px; background: var(--ink); }
  .reel { width: 100%; aspect-ratio: 9 / 16; object-fit: cover; border-radius: 15px; background: #2B1B47; }
  .reel-demo {
    display: flex; flex-direction: column; align-items: center; justify-content: space-between;
    padding: 18px 10px; text-align: center; color: #F6F0E6;
    background:
      radial-gradient(circle at 30% 20%, rgba(47, 211, 193, 0.35), transparent 50%),
      radial-gradient(circle at 70% 80%, rgba(246, 174, 94, 0.35), transparent 55%),
      linear-gradient(160deg, #3D1F63, #15101F);
  }
  .reel-demo .eyebrow { color: #D9B856; margin: 0; font-size: 9px; }
  .demo-lines { position: relative; height: 1.4em; width: 100%; font: 800 clamp(1.2rem, 5vw, 1.8rem)/1.4 var(--font-display); }
  .demo-lines span { position: absolute; inset: 0; opacity: 0; animation: cycle 4.5s infinite; }
  .demo-lines span:nth-child(2) { animation-delay: 1.5s; }
  .demo-lines span:nth-child(3) { animation-delay: 3s; }
  @media (prefers-reduced-motion: reduce) { .demo-lines span:first-child { opacity: 1; } }
  @keyframes cycle { 0%, 30% { opacity: 1; transform: none; } 34%, 100% { opacity: 0; transform: translateY(-6px); } }
  .mute {
    position: absolute; right: 14px; bottom: 14px; width: 40px; height: 40px; border-radius: 50%;
    display: grid; place-items: center; border: 2px solid #F6F0E6; background: rgba(21, 16, 31, 0.7); color: #F6F0E6;
  }
  .mute[aria-pressed='true'] :global(.i-sound), .mute[aria-pressed='false'] :global(.i-muted) { display: none; }

  .scroll-cue {
    position: absolute; left: 50%; bottom: 40px; transform: translateX(-50%);
    display: none; flex-direction: column; align-items: center; gap: 6px;
    font: 400 10px/1 var(--font-pixel); letter-spacing: 0.2em; text-transform: uppercase; color: var(--reign); text-decoration: none;
  }
  .scroll-cue :global(.pixel) { width: 14px; animation: bounce 1.2s steps(3) infinite; }
  @keyframes bounce { 50% { transform: translateY(5px); } }

  @media (min-width: 900px) {
    .hero-grid { grid-template-columns: 1.3fr 1fr; align-items: center; justify-items: start; text-align: left; gap: 48px; }
    .copy { align-items: flex-start; }
    .ctas { justify-content: flex-start; }
    .reel-wrap { width: min(300px, calc((100svh - 200px) * 9 / 16)); justify-self: center; }
    .scroll-cue { display: flex; }
  }

  /* Rewind intro (first visit only) */
  .rewind-fx { display: none; }
  :global(.rewind) .rewind-fx {
    display: grid; place-items: center; position: absolute; inset: 0; z-index: 5; pointer-events: none;
    background:
      repeating-linear-gradient(0deg, rgba(21, 16, 31, 0.28) 0 2px, transparent 2px 4px),
      linear-gradient(rgba(61, 31, 99, 0.35), rgba(61, 31, 99, 0.35));
    animation: rewind 1.2s steps(12) forwards;
  }
  .rw-label { font: 400 12px/1 var(--font-pixel); letter-spacing: 0.2em; text-transform: uppercase; color: #F6F0E6; background: #15101F; padding: 10px 12px; }
  :global(.rewind) .copy, :global(.rewind) .reel-wrap { animation: title-in 500ms 1.1s var(--ease) backwards; }
  @keyframes rewind {
    0% { opacity: 1; transform: translateY(0); }
    20% { transform: translateY(-6px); }
    40% { opacity: 0.85; transform: translateY(4px); }
    60% { transform: translateY(-3px); }
    90% { opacity: 0.7; }
    100% { opacity: 0; visibility: hidden; }
  }
  @keyframes title-in { from { transform: translateY(10px); filter: blur(2px); } }
</style>
